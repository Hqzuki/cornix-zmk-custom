config COREX_PAW3222
    bool "CoreX PAW3222 three-wire GPIO driver"
    default y if DT_HAS_COREX_PAW3222_GPIO_ENABLED
    depends on GPIO && INPUT

config COREX_LED_STATUS
    bool "Shared CoreX and Cornix LED status"
    default y if SHIELD_CORNIX_INDICATOR || (BOARD_COREX_RIGHT && ZMK_BLE)
    depends on ZMK_BLE

config COREX_CORON_KEYMAP
    bool "CoronLP keymap support"
    default y if (BOARD_COREX_RIGHT || BOARD_CORNIX_RIGHT) && ZMK_BLE

config CORNIX_AUTO_OS
    bool "Detect Bluetooth host layout automatically"
    default y if COREX_CORON_KEYMAP && ZMK_SPLIT_ROLE_CENTRAL && !SHIELD_SETTINGS_RESET
    depends on ZMK_BLE && ZMK_SPLIT_ROLE_CENTRAL
    select BT_GATT_AUTHORIZATION_CUSTOM

config CORNIX_AUTO_OS_SETTLE_MS
    int "Wait after new Bluetooth fingerprint evidence (ms)"
    depends on CORNIX_AUTO_OS
    range 500 5000
    default 1000
