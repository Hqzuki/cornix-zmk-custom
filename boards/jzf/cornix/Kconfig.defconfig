## Stock Cornix left: split peripheral of the CoreX right central
if BOARD_CORNIX_LEFT

config ZMK_SPLIT
	default y

config ZMK_BLE
	default y

config ZMK_SPLIT_ROLE_CENTRAL
    default n

config ZMK_SPLIT_BLE_ROLE_CENTRAL
	default n

config BOARD_CORNIX_CHARGER
    default y

# Add keyboard debouncing
config ZMK_KSCAN_DEBOUNCE_PRESS_MS
    default 3
config ZMK_KSCAN_DEBOUNCE_RELEASE_MS
    default 3

## disable rgb by default
config ZMK_RGB_UNDERGLOW
	default n
config ZMK_RGB_UNDERGLOW_EXT_POWER
	default n

endif # BOARD_CORNIX_LEFT

# Pure Cornix: stock right is the host-facing central.
if BOARD_CORNIX_RIGHT
config ZMK_KEYBOARD_NAME
    default "Cornix ZMK"
config ZMK_SPLIT
    default y
config ZMK_SPLIT_ROLE_CENTRAL
    default y
config ZMK_BLE
    default y
config USB_NRFX
    default y if USB
config USB_DEVICE_STACK
    default y if USB
config BT_MAX_CONN
    default 6 if ZMK_BLE
config BT_MAX_PAIRED
    default 6 if ZMK_BLE
config ZMK_SPLIT_BLE_CENTRAL_BATTERY_LEVEL_FETCHING
    default y if ZMK_SPLIT_BLE
config ZMK_SPLIT_BLE_CENTRAL_BATTERY_LEVEL_PROXY
    default y if ZMK_SPLIT_BLE
config ZMK_STUDIO
    default y if !SHIELD_SETTINGS_RESET
endif
