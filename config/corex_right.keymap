/* CoreX NUM/FN adaptation of Hqzuki/zmk-config-coron, LowprofileTrackBallcase.
 * 49 positions: dedicated arrow keys removed, BT-layer/screenshot on inner
 * switches, three spare bottom-right keys disabled in WIN/MAC.
 * LED and CoreX hardware configuration are independent of this keymap.
 */

#include <dt-bindings/zmk/input_transform.h>
#include <input/processors.dtsi>
#include <mouse-gesture.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&zip_temp_layer { excluded-positions = <19 20 21 33 34>; };

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&zip_mouse_gesture {
    mac-layer = <1>;
    stroke-size = <100>;
    movement-threshold = <6>;
    gesture-cooldown-ms = <250>;
    enable-eager-mode;

    desktop_left {
        pattern = <GESTURE_LEFT>;
        win-bindings = <&kp LC(LG(LEFT_ARROW))>;
        mac-bindings = <&kp LC(LEFT_ARROW)>;
    };

    desktop_right {
        pattern = <GESTURE_RIGHT>;
        win-bindings = <&kp LC(LG(RIGHT_ARROW))>;
        mac-bindings = <&kp LC(RIGHT_ARROW)>;
    };

    desktop_overview_up {
        pattern = <GESTURE_UP>;
        win-bindings = <&kp LG(TAB)>;
        mac-bindings = <&kp LC(UP_ARROW)>;
    };

    desktop_overview_down {
        pattern = <GESTURE_DOWN>;
        win-bindings = <&kp LG(TAB)>;
        mac-bindings = <&kp LC(DOWN_ARROW)>;
    };
};

&corex_listener {
    status = "okay";
    input-processors =
        <&zip_xy_transform (INPUT_TRANSFORM_X_INVERT | INPUT_TRANSFORM_Y_INVERT)>,
        <&zip_xy_scaler 4 5>,
        <&zip_temp_layer 6 0>;

    pan_scroll {
        layers = <4>;
        input-processors = <
            &zip_xy_transform INPUT_TRANSFORM_X_INVERT
            &zip_axis_lock
            &zip_xy_to_scroll_mapper
            &pan_direction
#if defined(CORON_SCROLL_INERTIA)
            &scroll_inertia
#endif
            &zip_scroll_scaler 1 12
        >;
    };

    desktop_layer_gesture {
        layers = <5>;
        input-processors = <
            &zip_xy_transform (INPUT_TRANSFORM_X_INVERT | INPUT_TRANSFORM_Y_INVERT)
            &zip_mouse_gesture
            &zip_xy_scaler 0 1
        >;
    };
};

/ {
    pan_direction: pan_direction {
        compatible = "custom,input-processor-pan-direction";
        #input-processor-cells = <0>;
        mac-layer = <1>;
    };

    #if defined(CORON_SCROLL_INERTIA)

    /* Inertia emits directly to HID: apply direction transforms before it,
     * and keep scale/scale-div equal to the downstream scroll scaler.
     * Only the right (central) half can emit mouse HID reports.
     */

    scroll_inertia: scroll_inertia {
        compatible = "zmk,input-processor-scroll-inertia";
        #input-processor-cells = <0>;
        axis = <0>;
        layer = <4>;
        scale = <1>;
        scale-div = <12>;

        /* Initial thresholds for the 400 CPI, 125 Hz sensor. */

        start = <16>;
        move = <32>;
        stop = <1>;
        tick = <8>;
        release = <24>;
        span = <5000>;
    };

    #endif

    layer_listeners {
        compatible = "zmk,layer-listeners";

        desktop_gesture_auto_toggle {
            layers = <5>;
            bindings = <&mouse_gesture_on &mouse_gesture_off>;
        };
    };

    macros {
        pair_paren: pair_paren {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            display-name = "Pair ()";
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&macro_tap>, <&kp LS(N9) &kp LS(N0) &kp LEFT>;
        };

        pair_square: pair_square {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            display-name = "Pair []";
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&macro_tap>, <&kp LBKT &kp RBKT &kp LEFT>;
        };

        pair_brace: pair_brace {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            display-name = "Pair {}";
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&macro_tap>, <&kp LS(LBKT) &kp LS(RBKT) &kp LEFT>;
        };

        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };

        /* Keep legacy macro node names so existing Studio bindings resolve.
         * All five now select only a Bluetooth slot; OS is always automatic. */

        bt0_mac: bt0_mac {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 0>;
            display-name = "BT 0";
            label = "BT0_MAC";
        };

        bt1_win: bt1_win {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 1>;
            display-name = "BT 1";
            label = "BT1_WIN";
        };

        bt2_win: bt2_win {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 2>;
            display-name = "BT 2";
            label = "BT2_WIN";
        };

        bt3_win: bt3_win {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 3>;
            display-name = "BT 3";
            label = "BT3_WIN";
        };

        bt4_win: bt4_win {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 4>;
            display-name = "BT 4";
            label = "BT4_WIN";
        };
    };

    behaviors {
        window_up: window_up {
            compatible = "custom,behavior-os-key";
            #binding-cells = <0>;
            mac-layer = <1>;
            win-keycode = <LG(LS(LEFT))>;
            mac-keycode = <LG(UP)>;
        };

        window_left: window_left {
            compatible = "custom,behavior-os-key";
            #binding-cells = <0>;
            mac-layer = <1>;
            win-keycode = <LG(LEFT)>;
            mac-keycode = <LG(LEFT)>;
        };

        window_down: window_down {
            compatible = "custom,behavior-os-key";
            #binding-cells = <0>;
            mac-layer = <1>;
            win-keycode = <LG(LS(RIGHT))>;
            mac-keycode = <LG(DOWN)>;
        };

        window_right: window_right {
            compatible = "custom,behavior-os-key";
            #binding-cells = <0>;
            mac-layer = <1>;
            win-keycode = <LG(RIGHT)>;
            mac-keycode = <LG(RIGHT)>;
        };

        /* NAV: single tap = arrow, double tap = OS-specific Window action. */

        nav_up: nav_up {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp UP>, <&window_up>;
        };

        nav_left: nav_left {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp LEFT>, <&window_left>;
        };

        nav_down: nav_down {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp DOWN>, <&window_down>;
        };

        nav_right: nav_right {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp RIGHT>, <&window_right>;
        };

        /* Consumes rotation without output; an omitted binding would fall
         * through to the WIN/MAC base layer.
         */

        enc_off: enc_off {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&none>, <&none>;
        };

        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        WIN {
            display-name = "WIN";
            bindings = <
&kp ESC         &kp Q         &kp W         &kp E        &kp R        &kp T                               &kp Y  &kp U        &kp I      &kp O           &mt SEMICOLON SQT   &kp BACKSPACE
&kp TAB         &kp A         &kp S         &kp D        &kp F        &kp G                               &kp H  &kp J        &kp K      &kp L           &mt MINUS P         &kp ENTER
&kp LEFT_SHIFT  &kp Z         &kp X         &kp C        &kp V        &kp B  &lt 7 PSCRN  &lt (7) LC(N0)  &kp N  &kp M        &kp COMMA  &kp DOT         &mt EQUAL UP_ARROW  &mt RSHFT SLASH
&kp LCTRL       &kp LEFT_WIN  &kp LEFT_ALT  &lt 8 SPACE  &lt 4 LANG2  &mo 5                               &mo 3  &lt 2 LANG1             &kp LEFT_ARROW  &kp DOWN_ARROW      &kp RIGHT_ARROW
            >;

            sensor-bindings =
                <&inc_dec_kp LG(LS(S)) LA(PSCRN)>,
                <&inc_dec_kp C_AC_ZOOM_IN C_AC_ZOOM_OUT>;
        };

        MAC {
            display-name = "MAC";
            bindings = <
&kp ESC         &kp Q      &kp W         &kp E        &kp R        &kp T                                      &kp Y  &kp U        &kp I      &kp O      &mt SEMICOLON SQT  &kp BACKSPACE
&kp TAB         &kp A      &kp S         &kp D        &kp F        &kp G                                      &kp H  &kp J        &kp K      &kp L      &kp P              &kp ENTER
&kp LEFT_SHIFT  &kp Z      &kp X         &kp C        &kp V        &kp B  &lt (7) LG(LS(N3))  &lt (7) LG(N0)  &kp N  &kp M        &kp COMMA  &kp DOT    &mt MINUS EQUAL    &mt RSHFT SLASH
&kp LEFT_GUI    &kp LCTRL  &kp LEFT_ALT  &lt 8 SPACE  &lt 4 LANG2  &mo 5                                      &mo 3  &lt 2 LANG1             &kp MINUS  &kp EQUAL          &kp DELETE
            >;

            sensor-bindings = <&inc_dec_kp LG(LS(N7)) LG(LS(N9)) &inc_dec_kp LG(LS(EQUAL)) LG(MINUS)>;
        };

        NUM {
            display-name = "NUM";
            bindings = <
&kp N1  &kp N2  &kp N3  &pair_square  &pair_paren     &kp BACKSLASH                  &trans  &trans  &trans  &trans  &trans  &trans
&kp N4  &kp N5  &kp N6  &kp TILDE     &kp UNDERSCORE  &pair_brace                    &trans  &trans  &trans  &trans  &trans  &trans
&kp N7  &kp N8  &kp N9  &kp GRAVE     &trans          &trans         &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &kp N0  &trans        &trans          &trans                         &trans  &trans          &trans  &trans  &trans
            >;

            sensor-bindings = <&enc_off &enc_off>;
        };

        FN {
            display-name = "FN";
            bindings = <
&kp F1   &kp F2   &kp F3   &pair_square  &pair_paren     &kp BACKSLASH                  &trans  &trans  &trans  &trans  &trans  &trans
&kp F4   &kp F5   &kp F6   &kp TILDE     &kp UNDERSCORE  &pair_brace                    &trans  &trans  &trans  &trans  &trans  &trans
&kp F7   &kp F8   &kp F9   &kp GRAVE     &trans          &trans         &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&kp F10  &kp F11  &kp F12  &trans        &trans          &trans                         &trans  &trans          &trans  &trans  &trans
            >;

            sensor-bindings = <&enc_off &enc_off>;
        };

        PAN {
            display-name = "PAN";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans          &trans  &trans  &trans
            >;

            sensor-bindings = <&enc_off &enc_off>;
        };

        GESTURE {
            display-name = "GESTURE";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans          &trans  &trans  &trans
            >;

            sensor-bindings = <&enc_off &enc_off>;
        };

        MOUSE {
            display-name = "MOUSE";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans    &trans    &trans    &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &mkp MB1  &mkp MB3  &mkp MB2  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &mkp MB4  &mkp MB5  &trans    &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans              &trans    &trans  &trans
            >;

            /* No sensor-bindings: knobs fall through to the WIN/MAC base layer. */
        };

        BLUETOOTH {
            display-name = "BLUETOOTH";
            bindings = <
&bootloader  &trans  &trans  &trans  &trans  &trans                  &bt0_mac  &bt1_win  &bt2_win  &bt3_win  &bt4_win    &bootloader
&trans       &trans  &trans  &trans  &trans  &trans                  &trans    &trans    &trans    &trans    &trans      &trans
&trans       &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans    &trans    &trans    &trans      &trans
&trans       &trans  &trans  &trans  &trans  &trans                  &trans    &trans              &trans    &bt BT_CLR  &bt BT_CLR_ALL
            >;

            sensor-bindings = <&enc_off &enc_off>;
        };

        NAV {
            display-name = "NAV";
            bindings = <
&trans  &trans  &trans     &nav_up    &trans      &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &nav_left  &nav_down  &nav_right  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans     &trans     &trans      &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans     &trans     &trans      &trans                  &trans  &trans          &trans  &trans  &trans
            >;

            sensor-bindings = <&enc_off &enc_off>;
        };
    };
};
