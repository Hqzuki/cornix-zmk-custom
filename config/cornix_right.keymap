/* Stock Cornix, 50 keys. Right central; no trackball hardware. */
#include <dt-bindings/zmk/input_transform.h>
#include <input/processors.dtsi>
#include <dt-bindings/zmk_behavior_default_layer/default_layer.h>
#include <behaviors/default_layer.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

/ {
    macros {
        pair_paren: pair_paren {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            display-name = "Pair ()";
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&macro_tap>, <&kp LS(N9) &kp LS(N0) &kp LEFT>;
        };

        pair_square: pair_square {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            display-name = "Pair []";
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&macro_tap>, <&kp LBKT &kp RBKT &kp LEFT>;
        };

        pair_brace: pair_brace {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            display-name = "Pair {}";
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&macro_tap>, <&kp LS(LBKT) &kp LS(RBKT) &kp LEFT>;
        };

        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };

        bt0_mac: bt0_mac {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 0 &df DF_BLE_SEL 1>;
            label = "BT0_MAC";
        };

        bt1_win: bt1_win {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 1 &df DF_BLE_SEL 0>;
            label = "BT1_WIN";
        };

        bt2_win: bt2_win {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 2 &df DF_BLE_SEL 0>;
            label = "BT2_WIN";
        };

        bt3_win: bt3_win {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 3 &df DF_BLE_SEL 0>;
            label = "BT3_WIN";
        };

        bt4_win: bt4_win {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 4 &df DF_BLE_SEL 0>;
            label = "BT4_WIN";
        };
    };

    behaviors {
        window_up: window_up {
            compatible = "custom,behavior-os-key";
            #binding-cells = <0>;
            mac-layer = <1>;
            win-keycode = <LG(LS(LEFT))>;
            mac-keycode = <LG(UP)>;
        };

        window_left: window_left {
            compatible = "custom,behavior-os-key";
            #binding-cells = <0>;
            mac-layer = <1>;
            win-keycode = <LG(LEFT)>;
            mac-keycode = <LG(LEFT)>;
        };

        window_down: window_down {
            compatible = "custom,behavior-os-key";
            #binding-cells = <0>;
            mac-layer = <1>;
            win-keycode = <LG(LS(RIGHT))>;
            mac-keycode = <LG(DOWN)>;
        };

        window_right: window_right {
            compatible = "custom,behavior-os-key";
            #binding-cells = <0>;
            mac-layer = <1>;
            win-keycode = <LG(RIGHT)>;
            mac-keycode = <LG(RIGHT)>;
        };

        /* Consumes rotation without output; an omitted binding would fall
         * through to the WIN/MAC base layer.
         */

        enc_off: enc_off {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&none>, <&none>;
        };

        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        WIN {
            display-name = "WIN";
            bindings = <
&kp ESC         &kp Q         &kp W         &kp E      &kp R        &kp T                           &kp Y  &kp U        &kp I      &kp O    &mt SEMICOLON SQT  &kp BACKSPACE
&kp TAB         &kp A         &kp S         &kp D      &kp F        &kp G                           &kp H  &kp J        &kp K      &kp L    &kp P              &kp ENTER
&kp LEFT_SHIFT  &kp Z         &kp X         &kp C      &kp V        &kp B  &lt 7 PSCRN  &kp LC(N0)  &kp N  &kp M        &kp COMMA  &kp DOT  &kp SLASH          &kp RSHFT
&kp LCTRL  &kp LEFT_WIN  &kp LEFT_ALT  &kp SPACE  &lt 4 LANG2  &mo 5  &mo 3  &lt 2 LANG1  &none  &kp MINUS  &kp EQUAL  &kp DELETE
            >;

            sensor-bindings =
                <&inc_dec_kp LG(LS(S)) LA(PSCRN)>,
                <&inc_dec_kp C_AC_ZOOM_IN C_AC_ZOOM_OUT>;
        };

        MAC {
            display-name = "MAC";
            bindings = <
&kp ESC         &kp Q      &kp W         &kp E      &kp R        &kp T                                  &kp Y  &kp U        &kp I      &kp O      &mt SEMICOLON SQT  &kp BACKSPACE
&kp TAB         &kp A      &kp S         &kp D      &kp F        &kp G                                  &kp H  &kp J        &kp K      &kp L      &kp P              &kp ENTER
&kp LEFT_SHIFT  &kp Z      &kp X         &kp C      &kp V        &kp B  &lt (7) LG(LS(N3))  &kp LG(N0)  &kp N  &kp M        &kp COMMA  &kp DOT    &kp SLASH          &kp RSHFT
&kp LEFT_GUI  &kp LCTRL  &kp LEFT_ALT  &kp SPACE  &lt 4 LANG2  &mo 5  &mo 3  &lt 2 LANG1  &none  &kp MINUS  &kp EQUAL  &kp DELETE
            >;

            sensor-bindings = <&inc_dec_kp LG(LS(N4)) LG(LS(N9)) &inc_dec_kp C_AC_ZOOM_IN C_AC_ZOOM_OUT>;
        };

        NUM {
            display-name = "NUM";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &kp BACKSLASH  &pair_paren     &pair_square  &kp N1  &kp N2  &kp N3
&trans  &trans  &trans  &trans  &trans  &trans                  &pair_brace    &kp UNDERSCORE  &kp TILDE     &kp N4  &kp N5  &kp N6
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans         &trans          &kp GRAVE     &kp N7  &kp N8  &kp N9
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp N0  &trans  &trans
            >;

            sensor-bindings = <&enc_off &enc_off>;
        };

        FN {
            display-name = "FN";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &kp BACKSLASH  &pair_paren     &pair_square  &kp F1   &kp F2   &kp F3
&trans  &trans  &trans  &trans  &trans  &trans                  &pair_brace    &kp UNDERSCORE  &kp TILDE     &kp F4   &kp F5   &kp F6
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans         &trans          &kp GRAVE     &kp F7   &kp F8   &kp F9
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp F10  &kp F11  &kp F12
            >;

            sensor-bindings = <&enc_off &enc_off>;
        };

        PAN {
            display-name = "PAN";
            bindings = <
&trans  &trans  &trans    &kp UP    &trans     &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &kp LEFT  &kp DOWN  &kp RIGHT  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans    &trans    &trans     &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;

            sensor-bindings = <&enc_off &enc_off>;
        };

        GESTURE {
            display-name = "GESTURE";
            bindings = <
&trans  &trans  &trans    &kp UP    &trans     &trans                  &trans  &trans        &window_up    &trans         &trans  &trans
&trans  &trans  &kp LEFT  &kp DOWN  &kp RIGHT  &trans                  &trans  &window_left  &window_down  &window_right  &trans  &trans
&trans  &trans  &trans    &trans    &trans     &trans  &trans  &trans  &trans  &trans        &trans        &trans         &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;

            sensor-bindings = <&enc_off &enc_off>;
        };

        MOUSE {
            display-name = "MOUSE";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans    &trans    &trans    &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &mkp MB1  &mkp MB3  &mkp MB2  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &mkp MB4  &mkp MB5  &trans    &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;

            /* No sensor-bindings: knobs fall through to the WIN/MAC base layer. */
        };

        BLUETOOTH {
            display-name = "BLUETOOTH";
            bindings = <
&bootloader  &trans  &trans  &trans  &trans  &trans                  &bt0_mac  &bt1_win  &bt2_win  &bt3_win  &bt4_win  &bootloader
&trans       &trans  &trans  &trans  &trans  &trans                  &trans    &trans    &trans    &trans    &trans    &trans
&trans       &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans    &trans    &trans    &trans    &bt BT_CLR
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;

            sensor-bindings = <&enc_off &enc_off>;
        };
    };
};
